+#elif defined(DREAM_HOST_MIPS)
+// FCSR bit 24 (FS): flush denormal results to zero.
+constexpr unsigned kFcsrFs = 1u << 24;
+
+unsigned read_fcsr() noexcept {
+    unsigned v;
+    asm volatile("cfc1 %0, $31" : "=r"(v));
+    return v;
+}
+
+void set_flush(bool on) noexcept {
+    unsigned v = read_fcsr();
+    v = on ? (v | kFcsrFs) : (v & ~kFcsrFs);
+    asm volatile("ctc1 %0, $31" : : "r"(v));
+}
+
+bool get_flush() noexcept {
+    return (read_fcsr() & kFcsrFs) != 0;
+}
+
+// FCSR bits 1:0 (RM): 0 round to nearest, 1 toward zero. newlib-psp's fesetround is a stub that
+// returns an error without touching the FPU, so the field is written here directly.
+constexpr unsigned kFcsrRm = 3u;
+constexpr unsigned kFcsrRmNearest = 0u;
+constexpr unsigned kFcsrRmZero = 1u;
+
+void set_rounding(Rounding r) noexcept {
+    unsigned v = read_fcsr() & ~kFcsrRm;
+    v |= r == Rounding::Nearest ? kFcsrRmNearest : kFcsrRmZero;
+    asm volatile("ctc1 %0, $31" : : "r"(v));
+}
+
+Rounding get_rounding() noexcept {
+    return (read_fcsr() & kFcsrRm) == kFcsrRmZero ? Rounding::TowardZero : Rounding::Nearest;
+}
+#else
+void set_rounding(Rounding r) noexcept {
+    std::fesetround(r == Rounding::Nearest ? FE_TONEAREST : FE_TOWARDZERO);
+}
+
+Rounding get_rounding() noexcept {
+    return std::fegetround() == FE_TOWARDZERO ? Rounding::TowardZero : Rounding::Nearest;
+}
 #endif
 
