--- a/runtime/src/fenv.cpp	2026-11-05 22:56:22.459642490 -0600
+++ b/runtime/src/fenv.cpp	2026-11-05 22:56:58.908092553 -0600
@@ -10,6 +10,8 @@
 #if defined(_MSC_VER)
 #include <intrin.h>
 #endif
+#elif defined(__mips__)
+#define DREAM_HOST_MIPS 1
 #else
 #error "dream::fenv: unsupported host ISA (need x86-64 or ARM64)"
 #endif
@@ -65,6 +67,25 @@
 bool get_flush() noexcept {
     return (read_fpcr() & kFpcrFz) != 0;
 }
+#elif defined(DREAM_HOST_MIPS)
+// FCSR bit 24 (FS): flush denormal results to zero.
+constexpr unsigned kFcsrFs = 1u << 24;
+
+unsigned read_fcsr() noexcept {
+    unsigned v;
+    asm volatile("cfc1 %0, $31" : "=r"(v));
+    return v;
+}
+
+void set_flush(bool on) noexcept {
+    unsigned v = read_fcsr();
+    v = on ? (v | kFcsrFs) : (v & ~kFcsrFs);
+    asm volatile("ctc1 %0, $31" : : "r"(v));
+}
+
+bool get_flush() noexcept {
+    return (read_fcsr() & kFcsrFs) != 0;
+}
 #endif
 
 }  // namespace
