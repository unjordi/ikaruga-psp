Cheap event counters for the per-frame log: FIPR/FTRV/FMAC executed, NonLocalReturn
thrown, scheduler callbacks run. Compiled in only with -DDREAM_PERF_COUNTERS; otherwise
DREAM_PERF_INC expands to nothing and the code is unchanged.

diff --git a/runtime/include/dream/runtime/perf.h b/runtime/include/dream/runtime/perf.h
new file mode 100644
index 0000000..a10ce3d
--- /dev/null
+++ b/runtime/include/dream/runtime/perf.h
@@ -0,0 +1,24 @@
+// Cheap event counters for the PSP build's per-frame log (DREAM_PERF_COUNTERS).
+// Plain increments on a global; the host reads and resets them. Without the macro every
+// DREAM_PERF_INC expands to nothing.
+#pragma once
+
+#include <cstdint>
+
+namespace dream::perf {
+
+struct Counters {
+    std::uint32_t fipr = 0, ftrv = 0, fmac = 0;  // SH-4 vector/fused FPU ops executed
+    std::uint32_t throws = 0;                    // NonLocalReturn thrown
+    std::uint32_t sched_events = 0;              // scheduler callbacks run
+};
+
+extern Counters counters;
+
+}  // namespace dream::perf
+
+#ifdef DREAM_PERF_COUNTERS
+#define DREAM_PERF_INC(field) (++::dream::perf::counters.field)
+#else
+#define DREAM_PERF_INC(field) ((void)0)
+#endif
