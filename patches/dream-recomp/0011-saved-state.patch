+}  // namespace aica
+
+namespace hle {
+// The disc is not saved: the host reopens the same image and attaches it again.
+DREAM_STATE_IO(Bios, "BIOS", 1, (S(gd_), S(sectors_read)))
+}  // namespace hle
+
+namespace maple {
+namespace {
+// Port devices: a kind byte, then the device's own state (0 none, 1 controller, 2 memory card).
+void save_device(state::Writer& w, const Device* d) {
+    if (auto* pad = dynamic_cast<const Controller*>(d)) {
+        w.pod(std::uint8_t{1});
+        w.pod(pad->state);
+        w.pod(pad->condition_reads);
+    } else if (auto* card = dynamic_cast<const MemoryCard*>(d)) {
+        w.pod(std::uint8_t{2});
+        w.vec(card->image());
+        for (std::uint64_t v : {card->block_reads, card->block_writes, card->media_info_reads,
+                                card->screen_writes})
+            w.u64(v);
+    } else {
+        w.pod(std::uint8_t{0});
+    }
+}
+
+void load_device(state::Reader& r, Device* d) {
+    const auto kind = r.get<std::uint8_t>();
+    if (auto* pad = dynamic_cast<Controller*>(d); pad && kind == 1) {
+        r.pod(pad->state);
+        r.pod(pad->condition_reads);
+    } else if (auto* card = dynamic_cast<MemoryCard*>(d); card && kind == 2) {
+        std::vector<std::uint8_t> image;
+        r.vec(image);
+        // The card file on disk already holds every block the guest saved (save() writes through);
+        // the image is restored in memory only, without writing the file again.
+        if (!card->set_image(image))
+            throw state::Error("state: memory card image of the wrong size");
+        for (std::uint64_t* v : {&card->block_reads, &card->block_writes, &card->media_info_reads,
+                                 &card->screen_writes})
+            *v = r.u64();
+    } else if (kind != 0 || d) {
+        throw state::Error("state: the maple devices attached differ from the saved ones");
+    }
+}
+}  // namespace
+
+void Bus::save(state::Writer& w) const {
+    w.begin("MAPL", 1);
+    for (std::uint32_t v : {mdstar, mdtsel, mden, mdst, msys, mshtcl, mdapro, mmsel})
+        w.u32(v);
+    w.u64(transfers);
+    w.u64(frames);
+    w.u64(no_device);
+    w.pod(frames_by_recipient);
+    w.pod(frames_by_command);
+    w.u32(static_cast<std::uint32_t>(out_.size()));
+    for (const auto& p : out_) {
+        w.u32(p.addr);
+        w.vec(p.words);
+    }
+    w.pod(trigger_pending_reset_);
+    for (unsigned port = 0; port < kPorts; ++port) {
+        save_device(w, ports_[port].get());
+        for (const auto& e : expansion_[port])
+            save_device(w, e.get());
+    }
+    w.end();
+}
+
+void Bus::load(state::Reader& r) {
+    r.begin("MAPL", 1);
+    for (std::uint32_t* v : {&mdstar, &mdtsel, &mden, &mdst, &msys, &mshtcl, &mdapro, &mmsel})
+        *v = r.u32();
+    transfers = r.u64();
+    frames = r.u64();
+    no_device = r.u64();
+    r.pod(frames_by_recipient);
+    r.pod(frames_by_command);
+    out_.resize(r.u32());
+    for (auto& p : out_) {
+        p.addr = r.u32();
+        r.vec(p.words);
+    }
+    r.pod(trigger_pending_reset_);
+    for (unsigned port = 0; port < kPorts; ++port) {
+        load_device(r, ports_[port].get());
+        for (auto& e : expansion_[port])
+            load_device(r, e.get());
+    }
+    r.end();
+}
+}  // namespace maple
+
+namespace mem {
+DREAM_STATE_IO(Utlb, "UTLB", 1, (S(addr_), S(data1_), S(data2_), S(associative_writes)))
