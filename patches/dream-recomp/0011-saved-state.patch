+namespace dream {
+
+// One field list per piece, used by both directions: S(x) writes or reads x as raw bytes.
+#define DREAM_STATE_IO(Class, TAG, VER, FIELDS)          \
+    void Class::save(state::Writer& w) const {           \
+        w.begin(TAG, VER);                               \
+        auto S = [&w](const auto& x) { w.pod(x); };      \
+        FIELDS;                                          \
+        w.end();                                         \
+    }                                                    \
+    void Class::load(state::Reader& r) {                 \
+        r.begin(TAG, VER);                               \
+        auto S = [&r](auto& x) { r.pod(x); };            \
+        FIELDS;                                          \
+        r.end();                                         \
+    }
