diff --git a/runtime/include/dream/runtime/state.h b/runtime/include/dream/runtime/state.h
new file mode 100644
index 0000000..46e45f4
--- /dev/null
+++ b/runtime/include/dream/runtime/state.h
@@ -0,0 +1,135 @@
+// Saved state: sections of tag (4 bytes) | version (u32) | body size (u32) | body, so a mismatch
+// names its section instead of misreading the next one. Host byte order: only the same build on
+// the same kind of host loads it (format: docs/estado-guardado.md in ikaruga-psp).
+#pragma once
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+namespace dream::state {
+
+struct Error : std::runtime_error {
+    using std::runtime_error::runtime_error;
+};
+
+class Writer {
+public:
+    explicit Writer(std::FILE* f) : f_(f) {}
+
+    void bytes(const void* p, std::size_t n) {
+        if (n && std::fwrite(p, 1, n, f_) != n)
+            throw Error("state: short write");
+        pos_ += n;
+    }
+    template <typename T>
+    void pod(const T& v) {
+        static_assert(std::is_trivially_copyable_v<T>);
+        bytes(&v, sizeof v);
+    }
+    void u32(std::uint32_t v) { pod(v); }
+    void u64(std::uint64_t v) { pod(v); }
+    void str(const std::string& s) {
+        u32(static_cast<std::uint32_t>(s.size()));
+        bytes(s.data(), s.size());
+    }
+    template <typename T>
+    void vec(const std::vector<T>& v) {
+        static_assert(std::is_trivially_copyable_v<T>);
+        u32(static_cast<std::uint32_t>(v.size()));
+        bytes(v.data(), v.size() * sizeof(T));
+    }
+
+    // begin/end bracket one section; the size is patched in place when it ends.
+    void begin(const char tag[4], std::uint32_t version) {
+        if (open_)
+            throw Error("state: nested section");
+        bytes(tag, 4);
+        u32(version);
+        size_at_ = std::ftell(f_);
+        u32(0);
+        body_start_ = pos_;
+        open_ = true;
+    }
+    void end() {
+        const std::uint32_t size = static_cast<std::uint32_t>(pos_ - body_start_);
+        const long here = std::ftell(f_);
+        std::fseek(f_, size_at_, SEEK_SET);
+        if (std::fwrite(&size, 4, 1, f_) != 1)
+            throw Error("state: short write");
+        std::fseek(f_, here, SEEK_SET);
+        open_ = false;
+    }
+
+private:
+    std::FILE* f_;
+    std::uint64_t pos_ = 0, body_start_ = 0;
+    long size_at_ = 0;
+    bool open_ = false;
+};
+
+class Reader {
+public:
+    explicit Reader(std::FILE* f) : f_(f) {}
+
+    void bytes(void* p, std::size_t n) {
+        if (n && std::fread(p, 1, n, f_) != n)
+            throw Error("state: file ends inside section " + tag_);
+        pos_ += n;
+    }
+    template <typename T>
+    void pod(T& v) {
+        static_assert(std::is_trivially_copyable_v<T>);
+        bytes(&v, sizeof v);
+    }
+    template <typename T>
+    T get() {
+        T v{};
+        pod(v);
+        return v;
+    }
+    std::uint32_t u32() { return get<std::uint32_t>(); }
+    std::uint64_t u64() { return get<std::uint64_t>(); }
+    std::string str() {
+        std::string s(u32(), '\0');
+        bytes(s.data(), s.size());
+        return s;
+    }
+    template <typename T>
+    void vec(std::vector<T>& v) {
+        v.resize(u32());
+        bytes(v.data(), v.size() * sizeof(T));
+    }
+
+    // Opens the next section, which must carry `tag` and `version`.
+    void begin(const char tag[4], std::uint32_t version) {
+        char got[5] = {};
+        tag_ = std::string(tag, 4);
+        bytes(got, 4);
+        if (std::memcmp(got, tag, 4) != 0)
+            throw Error("state: expected section " + tag_ + ", found " + got);
+        const std::uint32_t v = u32();
+        if (v != version)
+            throw Error("state: section " + tag_ + " version " + std::to_string(v) +
+                        ", this build reads " + std::to_string(version));
+        size_ = u32();
+        body_start_ = pos_;
+    }
+    void end() {
+        if (pos_ - body_start_ != size_)
+            throw Error("state: section " + tag_ + " has " + std::to_string(size_) +
+                        " bytes, read " + std::to_string(pos_ - body_start_));
+    }
+
+private:
+    std::FILE* f_;
+    std::uint64_t pos_ = 0, body_start_ = 0;
+    std::uint32_t size_ = 0;
+    std::string tag_;
+};
+
+}  // namespace dream::state
