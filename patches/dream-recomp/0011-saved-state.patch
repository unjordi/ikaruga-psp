+void Aica::load(state::Reader& r) {
+    r.begin("AICA", 1);
+    r.pod(regs_);  // before the mixer: its channels point into these registers
+    r.pod(last_left);
+    r.pod(last_right);
+    r.pod(timer_step_);
+    r.pod(timer_left_);
+    for (std::uint64_t* v : {&samples, &timer_irqs, &sh4_irq_raises, &channel_writes, &dsp_writes,
+                             &internal_dma_requests, &scpu_to_arm, &scpu_to_sh4,
+                             &arm_side_reg_writes, &sh4_side_reg_writes})
+        *v = r.u64();
+    r.end();
+    arm.load(r);
+    mixer.load(r);
