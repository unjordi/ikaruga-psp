+// The boot ROM image is not saved (the HLE BIOS never loads one).
+void DcMemory::save(state::Writer& w) const {
+    w.begin("MEM_", 1);
+    w.bytes(ram_.get(), kRamSize);
+    w.bytes(vram_.get(), kVramSize);
+    w.bytes(aram_.get(), kAramSize);
+    w.bytes(flash_.get(), kFlashSize);
+    w.bytes(ocram_.get(), kOcramSize);
+    w.pod(vram_write_epoch);
+    w.pod(vram_page_epoch);
+    w.pod(write_hash);
+    w.pod(writes_hashed);
+    w.pod(tra);
+    w.pod(expevt);
+    w.pod(intevt);
+    w.pod(sq_);
+    w.pod(qacr_);
+    w.pod(ccn_);
+    w.pod(sq_tlb_flushes);
+    w.pod(sq_tlb_misses);
+    w.end();
+    utlb_.save(w);
+}
+
+void DcMemory::load(state::Reader& r) {
+    r.begin("MEM_", 1);
+    r.bytes(ram_.get(), kRamSize);
+    r.bytes(vram_.get(), kVramSize);
+    r.bytes(aram_.get(), kAramSize);
+    r.bytes(flash_.get(), kFlashSize);
+    r.bytes(ocram_.get(), kOcramSize);
+    r.pod(vram_write_epoch);
+    r.pod(vram_page_epoch);
+    r.pod(write_hash);
+    r.pod(writes_hashed);
+    r.pod(tra);
+    r.pod(expevt);
+    r.pod(intevt);
+    r.pod(sq_);
+    r.pod(qacr_);
+    r.pod(ccn_);
+    r.pod(sq_tlb_flushes);
+    r.pod(sq_tlb_misses);
+    r.end();
+    utlb_.load(r);
+}
+}  // namespace mem
+
+// The SH-4 side and the devices System owns. The other devices (PVR, AICA, Maple, BIOS, DMAC,
+// SysBlock, G2-DMA, RTC) belong to the host, which saves them after this in its own order.
+void System::save(state::Writer& w) const {
+    if (nesting != 0)
+        throw state::Error("state: cannot save inside an exception handler");
+    w.begin("SYS_", 1);
+    w.pod(ctx);
+    w.pod(idle_prev);
+    for (std::uint64_t v : {idle_skips, idle_skipped_turns, idle_skipped_cycles,
+                            interrupts_delivered, traps_taken, device_accesses, task_switch_rtes})
+        w.u64(v);
+    w.end();
+    sched.save(w);
+    intc.save(w);
+    tmu.save(w);
+    holly.save(w);
+    spg.save(w);
+    memory.save(w);
+}
+
+void System::load(state::Reader& r) {
+    r.begin("SYS_", 1);
+    r.pod(ctx);
+    r.pod(idle_prev);
+    for (std::uint64_t* v : {&idle_skips, &idle_skipped_turns, &idle_skipped_cycles,
+                             &interrupts_delivered, &traps_taken, &device_accesses,
+                             &task_switch_rtes})
+        *v = r.u64();
+    r.end();
+    sched.load(r);
+    intc.load(r);
+    tmu.load(r);
+    holly.load(r);
+    spg.load(r);
+    memory.load(r);
+    // The host FPU follows the guest's FPSCR (rounding, flush to zero) as write_fpscr leaves it.
+    fenv::apply(fenv::from_fpscr(ctx.fpscr));
+}
+
+#undef DREAM_STATE_IO
+
+}  // namespace dream
