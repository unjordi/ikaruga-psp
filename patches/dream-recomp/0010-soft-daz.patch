+    Freg& operator=(float x) noexcept { v = x; return *this; }
+    Freg& operator+=(float x) noexcept { v = daz(v) + x; return *this; }
+    Freg& operator-=(float x) noexcept { v = daz(v) - x; return *this; }
+    Freg& operator*=(float x) noexcept { v = daz(v) * x; return *this; }
+    Freg& operator/=(float x) noexcept { v = daz(v) / x; return *this; }
