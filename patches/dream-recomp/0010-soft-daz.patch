+#if DREAM_SOFT_DAZ
+struct Freg {
+    float v;
+    static float daz(float x) noexcept {
+        std::uint32_t u;
+        std::memcpy(&u, &x, 4);
+        if ((u & 0x7F800000u) == 0) {
+            u &= 0x80000000u;
+            std::memcpy(&x, &u, 4);
+        }
+        return x;
+    }
