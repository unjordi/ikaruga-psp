FP registers read as zero when they hold a denormal (x86 MXCSR.DAZ) and FIPR/FTRV/FMAC flush a
denormal single result (MXCSR.FTZ) under -DDREAM_SOFT_DAZ=1. The PSP FPU with FCSR.FS flushes
results only, and its soft-double/fmaf paths ignore FS. Applies after 0009.

diff -ru base/runtime/include/dream/runtime/sh4/ctx.h new/runtime/include/dream/runtime/sh4/ctx.h
--- a/runtime/include/dream/runtime/sh4/ctx.h	2026-11-11 02:53:07.334051450 -0600
+++ b/runtime/include/dream/runtime/sh4/ctx.h	2026-11-11 02:55:33.593866587 -0600
@@ -13,9 +13,41 @@
 #pragma once
 
 #include <cstdint>
+#include <cstring>
+
+// DREAM_SOFT_DAZ=1: FP registers read as zero when they hold a denormal and feed arithmetic,
+// as x86 does with MXCSR.DAZ for the guest's FPSCR.DN. The PSP FPU (FCSR.FS) flushes denormal
+// results but takes denormal inputs as they are. Moves and stores keep the raw bits.
+#ifndef DREAM_SOFT_DAZ
+#define DREAM_SOFT_DAZ 0
+#endif
 
 namespace dream::sh4 {
 
+#if DREAM_SOFT_DAZ
+struct Freg {
+    float v;
+    static float daz(float x) noexcept {
+        std::uint32_t u;
+        std::memcpy(&u, &x, 4);
+        if ((u & 0x7F800000u) == 0) {
+            u &= 0x80000000u;
+            std::memcpy(&x, &u, 4);
+        }
+        return x;
+    }
+    operator float() const noexcept { return daz(v); }
+    Freg& operator=(float x) noexcept { v = x; return *this; }
+    Freg& operator+=(float x) noexcept { v = daz(v) + x; return *this; }
+    Freg& operator-=(float x) noexcept { v = daz(v) - x; return *this; }
+    Freg& operator*=(float x) noexcept { v = daz(v) * x; return *this; }
+    Freg& operator/=(float x) noexcept { v = daz(v) / x; return *this; }
+};
+static_assert(sizeof(Freg) == 4);
+#else
+using Freg = float;
+#endif
+
 struct Ctx {
     std::uint32_t r[16];      // general registers, current bank in r[0..7]
     std::uint32_t r_bank[8];  // the other bank of R0..R7
