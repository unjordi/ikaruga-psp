+// x86 SSE NaN results, for the double FIPR/FTRV/FMAC when a result is NaN: the first NaN operand
+// in operand order, quieted, or the default NaN 0xFFC00000 for inf*0 and inf-inf. The PSP's
+// soft-double (libgcc fp-bit) gives a product of NaNs the XOR of the signs instead.
+namespace x86fp {
+struct V {
+    bool nan;
+    std::uint32_t bits;  // when nan
+    double d;            // otherwise
+};
+inline V in(float f) noexcept {
+    std::uint32_t u;
+    std::memcpy(&u, &f, 4);
+    if ((u & 0x7F800000u) == 0x7F800000u && (u & 0x7FFFFFu))
+        return V{true, u | 0x00400000u, 0.0};
+    return V{false, 0, static_cast<double>(f)};
+}
+constexpr V kDefaultNan{true, 0xFFC00000u, 0.0};
+inline V mul(V a, V b) noexcept {
+    if (a.nan) return a;
+    if (b.nan) return b;
+    if ((std::isinf(a.d) && b.d == 0.0) || (a.d == 0.0 && std::isinf(b.d))) return kDefaultNan;
+    return V{false, 0, a.d * b.d};
+}
+inline V add(V a, V b) noexcept {
+    if (a.nan) return a;
+    if (b.nan) return b;
+    if (std::isinf(a.d) && std::isinf(b.d) && std::signbit(a.d) != std::signbit(b.d))
+        return kDefaultNan;
+    return V{false, 0, a.d + b.d};
+}
+inline float out(V v) noexcept {
+    if (!v.nan) return ftz(static_cast<float>(v.d));
+    float f;
+    std::memcpy(&f, &v.bits, 4);
+    return f;
+}
+// a0*b0 + a1*b1 + a2*b2 + a3*b3, left to right, a first in each product.
+inline float dot4(const float* a, const float* b) noexcept {
+    V d = mul(in(a[0]), in(b[0]));
+    for (int i = 1; i < 4; ++i) d = add(d, mul(in(a[i]), in(b[i])));
+    return out(d);
+}
+// glibc fmaf on x86-64 (vfmadd213ss): NaN operands in the order x, y, z.
+inline float fma(float x, float y, float z) noexcept {
+    const V a = in(x), b = in(y), c = in(z);
+    if (a.nan) return out(a);
+    if (b.nan) return out(b);
+    if (c.nan) return out(c);
+    return out(kDefaultNan);
+}
+}  // namespace x86fp
