+// Called at the head of a declared wait loop. A turn is skippable when the previous head was the
+// same loop, nothing was delivered, trapped or read from a device in between, and the whole
+// context matches except the cycle count and the timeout (one lower). Then the next k turns are
+// copies of it: the runtime adds k turns' cycles and lowers the timeout by k, stopping before any
+// turn that could reach next_event or end the loop on the timeout. Those turns run as translated,
+// so interrupts land at the same cycle as without skipping.
+void System::on_idle(sh4::Ctx& c, ::dream::Memory& m, std::uint32_t pc) {
+    struct Turn {
+        bool valid = false;
+        std::uint32_t pc = 0, timeout_addr = 0, timeout = 0;
+        std::uint64_t interrupts = 0, traps = 0, devices = 0;
+        sh4::Ctx ctx{};
+    };
+    static Turn prev;
+    if (idle_loops.find(pc) == idle_loops.end())
+        return;
+    const std::uint32_t timeout_addr = m.read32(c.r[15]);
+    std::uint32_t timeout = m.read32(timeout_addr);
+    if (prev.valid && prev.pc == pc && prev.timeout_addr == timeout_addr &&
+        prev.interrupts == interrupts_delivered && prev.traps == traps_taken &&
+        prev.devices == device_accesses && timeout != 0 && timeout + 1 == prev.timeout &&
+        c.r[3] == timeout && c.cycles > prev.ctx.cycles && c.next_event > c.cycles) {
+        sh4::Ctx a = prev.ctx, b = c;
+        a.cycles = b.cycles = 0;
+        a.next_event = b.next_event = 0;
+        a.r[3] = b.r[3] = 0;
+        if (!std::memcmp(&a, &b, sizeof a)) {
+            const std::uint64_t d = c.cycles - prev.ctx.cycles;
+            // The polls of a skipped turn fall at or before its end; keep them below next_event.
+            std::uint64_t k = (c.next_event - c.cycles - 1) / d;
+            k = std::min<std::uint64_t>(k, timeout - 1);
+            if (k) {
+                c.cycles += k * d;
+                timeout -= static_cast<std::uint32_t>(k);
+                m.write32(timeout_addr, timeout);
+                c.r[3] = timeout;
+                ++idle_skips;
+                idle_skipped_turns += k;
+                idle_skipped_cycles += k * d;
+            }
+        }
+    }
+    prev.valid = true;
+    prev.pc = pc;
+    prev.timeout_addr = timeout_addr;
+    prev.timeout = timeout;
+    prev.interrupts = interrupts_delivered;
+    prev.traps = traps_taken;
+    prev.devices = device_accesses;
+    prev.ctx = c;
+}
+
 void System::on_trapa(sh4::Ctx& c, ::dream::Memory& m, std::uint32_t imm) {
     memory.tra = (imm & 0xFFu) << 2;
     memory.expevt = 0x160;
