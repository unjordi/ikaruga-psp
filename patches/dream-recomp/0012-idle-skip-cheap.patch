@@ -72,7 +72,35 @@
     // katana_wait_vblank: kmWaitVBlank's inner loop; @r15 points at a timeout word that each turn
     // decrements by one, mirrored in r3 at the loop head.
     enum class IdleKind { katana_wait_vblank };
-    std::map<std::uint32_t, IdleKind> idle_loops;  // loop head block -> kind; empty = no skipping
+    // Loop head block -> kind; empty = no skipping. A handful of heads, so a linear scan.
+    class IdleTable {
+    public:
+        // Entry for `pc`, added when absent. Throws std::length_error past kMax heads.
+        IdleKind& operator[](std::uint32_t pc) {
+            for (unsigned i = 0; i < n_; ++i)
+                if (pc_[i] == pc)
+                    return kind_[i];
+            if (n_ == kMax)
+                throw std::length_error("idle_loops: too many loop heads");
+            pc_[n_] = pc;
+            kind_[n_] = IdleKind{};
+            return kind_[n_++];
+        }
+        bool contains(std::uint32_t pc) const noexcept {
+            for (unsigned i = 0; i < n_; ++i)
+                if (pc_[i] == pc)
+                    return true;
+            return false;
+        }
+        std::size_t size() const noexcept { return n_; }
+        bool empty() const noexcept { return n_ == 0; }
+
+    private:
+        static constexpr unsigned kMax = 8;
+        std::uint32_t pc_[kMax] = {};
+        IdleKind kind_[kMax] = {};
+        unsigned n_ = 0;
+    } idle_loops;
     // Returns false for an unknown kind name.
     static bool idle_kind_from_name(const std::string& name, IdleKind& kind);
     std::uint64_t idle_skips = 0, idle_skipped_turns = 0, idle_skipped_cycles = 0;
