+// DREAM_FPU_DOUBLE (default 0): FMAC, FIPR and FTRV are evaluated in single precision, one
+// product and one sum at a time, left to right, each rounded to float. It needs -ffp-contract=off
+// on every host (no implicit FMA), so x86-64 SSE and the PSP's Allegrex FPU give the same bits.
+// This is NOT the SH-4 (fused FMAC, wider FIPR/FTRV accumulation): it is what PC and PSP both run.
+// DREAM_FPU_DOUBLE=1 restores the upstream fused/double evaluation, to compare against it.
+#ifndef DREAM_FPU_DOUBLE
+#define DREAM_FPU_DOUBLE 0
+#endif
+#ifndef DREAM_PERF_INC
+#define DREAM_PERF_INC(name) ((void)0)
+#endif
+
+#if !DREAM_FPU_DOUBLE
+inline float fmac(float fr0, float frm, float frn) noexcept {
+    DREAM_PERF_INC(fmac);
+    const float p = fr0 * frm;
+    return p + frn;
+}
+#else
 // FMAC: FRn = FR0 * FRm + FRn with a single rounding (the SH-4 FMAC is a fused unit). Recorded
 // here as the one place the choice lives (ADR 16); WP1.5 checks it against the interpreter.
 inline float fmac(float fr0, float frm, float frn) noexcept {
     DREAM_PERF_INC(fmac);
     return std::fmaf(fr0, frm, frn);
 }
+#endif  // DREAM_FPU_DOUBLE
 
