+// FIPR FVm,FVn: FR[n+3] = ((a0*b0 + a1*b1) + a2*b2) + a3*b3, every product and sum in float.
+inline void fipr(Ctx& c, unsigned m, unsigned n) noexcept {
+    DREAM_PERF_INC(fipr);
+    const float* a = &c.fr[n];
+    const float* b = &c.fr[m];
+    float d = a[0] * b[0];
+    d += a[1] * b[1];
+    d += a[2] * b[2];
+    d += a[3] * b[3];
+    c.fr[n + 3] = d;
+}
+
+// FTRV XMTRX,FVn: FV[n] = XMTRX * FV[n] in float, one row at a time, same order as FIPR.
+inline void ftrv(Ctx& c, unsigned n) noexcept {
+    DREAM_PERF_INC(ftrv);
+    const float* v = &c.fr[n];
+    const float x = v[0], y = v[1], z = v[2], w = v[3];
+    const float* xm = c.xf;
+    float r[4];
+    for (unsigned i = 0; i < 4; ++i) {
+        float d = xm[i] * x;
+        d += xm[i + 4] * y;
+        d += xm[i + 8] * z;
+        d += xm[i + 12] * w;
+        r[i] = d;
+    }
+    for (unsigned i = 0; i < 4; ++i) c.fr[n + i] = r[i];
+}
