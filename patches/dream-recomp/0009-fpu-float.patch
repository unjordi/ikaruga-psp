+// FIPR FVm,FVn: FR[n+3] = ((a0*b0 + a1*b1) + a2*b2) + a3*b3, every product and sum in float,
+// denormals flushed.
+inline void fipr(Ctx& c, unsigned m, unsigned n) noexcept {
+    DREAM_PERF_INC(fipr);
+    using detail::ftz;
+    const float* a = &c.fr[n];
+    const float* b = &c.fr[m];
+    float d = ftz(ftz(a[0]) * ftz(b[0]));
+    d = ftz(d + ftz(ftz(a[1]) * ftz(b[1])));
+    d = ftz(d + ftz(ftz(a[2]) * ftz(b[2])));
+    d = ftz(d + ftz(ftz(a[3]) * ftz(b[3])));
+    c.fr[n + 3] = d;
+}
+
+// FTRV XMTRX,FVn: FV[n] = XMTRX * FV[n] in float, one row at a time, same order as FIPR.
+inline void ftrv(Ctx& c, unsigned n) noexcept {
+    DREAM_PERF_INC(ftrv);
+    using detail::ftz;
+    const float* v = &c.fr[n];
+    const float x = ftz(v[0]), y = ftz(v[1]), z = ftz(v[2]), w = ftz(v[3]);
+    const float* xm = c.xf;
+    float r[4];
+    for (unsigned i = 0; i < 4; ++i) {
+        float d = ftz(ftz(xm[i]) * x);
+        d = ftz(d + ftz(ftz(xm[i + 4]) * y));
+        d = ftz(d + ftz(ftz(xm[i + 8]) * z));
+        d = ftz(d + ftz(ftz(xm[i + 12]) * w));
+        r[i] = d;
+    }
+    for (unsigned i = 0; i < 4; ++i) c.fr[n + i] = r[i];
+}
