+}
+
+void Core::load(state::Reader& r) {
+    r.begin("PVR_", 1);
+    r.pod(regs_);
+    r.pod(fifo_buf_);
+    r.pod(fifo_fill_);
+    r.pod(seen_ta_data_);
+    r.pod(yuv_mb_);
+    r.pod(yuv_fill_);
+    r.pod(yuv_index_);
+    r.pod(renders);
+    r.pod(renders_done);
+    r.pod(frame_swaps);
+    r.pod(yuv_words);
+    r.pod(texture_words);
+    r.pod(list_inits);
+    r.pod(render_base_cycles);
+    r.pod(render_cycles_per_word);
+    r.end();
