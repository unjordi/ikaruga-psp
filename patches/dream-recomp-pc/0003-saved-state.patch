+// Saved state (dream/runtime/state.h): save/load of every runtime piece except the AICA mixer,
+// whose channel struct lives in aica/mixer.cpp. Each piece writes one section; callbacks, device
+// wiring and scheduler event ids are not saved: the loading host builds the system the same way
+// and these functions only overwrite the values that change while the guest runs.
+#include "dream/runtime/state.h"
+
+#include "dream/runtime/aica/aica.h"
+#include "dream/runtime/aica/arm7.h"
+#include "dream/runtime/aica/rtc.h"
+#include "dream/runtime/fenv.h"
+#include "dream/runtime/hle/bios.h"
+#include "dream/runtime/holly/g2dma.h"
+#include "dream/runtime/holly/intc.h"
+#include "dream/runtime/holly/sysblock.h"
+#include "dream/runtime/maple/maple.h"
+#include "dream/runtime/mem/dc_memory.h"
+#include "dream/runtime/pvr/core.h"
+#include "dream/runtime/pvr/spg.h"
+#include "dream/runtime/sh4/dmac.h"
+#include "dream/runtime/sh4/intc.h"
+#include "dream/runtime/sh4/tmu.h"
+#include "dream/runtime/system.h"
+
+namespace dream {
+
+// One field list per piece, used by both directions: S(x) writes or reads x as raw bytes.
+#define DREAM_STATE_IO(Class, TAG, VER, FIELDS)          \
+    void Class::save(state::Writer& w) const {           \
+        w.begin(TAG, VER);                               \
+        auto S = [&w](const auto& x) { w.pod(x); };      \
+        FIELDS;                                          \
+        w.end();                                         \
+    }                                                    \
+    void Class::load(state::Reader& r) {                 \
+        r.begin(TAG, VER);                               \
+        auto S = [&r](auto& x) { r.pod(x); };            \
+        FIELDS;                                          \
+        r.end();                                         \
+    }
+
+namespace sh4 {
+DREAM_STATE_IO(Intc, "INTC", 1, (S(ipra), S(iprb), S(iprc), S(icr), S(pending_)))
+DREAM_STATE_IO(Tmu, "TMU_", 1,
+               (S(tcor_), S(tcr_mode_), S(tcr_), S(tstr_), S(tocr_), S(shift_), S(running_),
+                S(base_)))
+DREAM_STATE_IO(Dmac, "DMAC", 1, (S(ch_), S(dmaor_), S(manual_transfers)))
+}  // namespace sh4
+
+namespace holly {
+DREAM_STATE_IO(Intc, "HINT", 1,
+               (S(istnrm), S(istext), S(isterr), S(iml2nrm), S(iml2ext), S(iml2err), S(iml4nrm),
+                S(iml4ext), S(iml4err), S(iml6nrm), S(iml6ext), S(iml6err)))
+DREAM_STATE_IO(G2Dma, "G2DM", 1, (S(regs_), S(transfers), S(bytes), S(refused), S(to_aica_ram)))
+DREAM_STATE_IO(SysBlock, "SYSB", 1,
+               (S(regs_), S(ch2_yuv_transfers), S(ch2_transfers), S(ch2_ta_bytes),
+                S(ch2_texture_bytes), S(ch2_errors), S(sort_dma_starts), S(first_refused),
+                S(last_refused)))
+}  // namespace holly
+
+namespace pvr {
+DREAM_STATE_IO(Spg, "SPG_", 1,
+               (S(spg_hblank_int), S(spg_vblank_int), S(spg_control), S(spg_hblank), S(spg_load),
+                S(spg_vblank), S(spg_width), S(vclk_full_), S(line_cycles_), S(scanline_),
+                S(vsync_), S(fieldnum_), S(frames_)))
+
+void Ta::save(state::Writer& w) const {
+    w.begin("TA__", 1);
+    w.pod(lists);
+    w.pod(chunks);
+    w.pod(invalid);
+    w.pod(current_list);
+    w.vec(stream);
+    w.pod(state_);
+    w.pod(pending_v64_);
+    w.end();
+}
+
+void Ta::load(state::Reader& r) {
+    r.begin("TA__", 1);
+    r.pod(lists);
+    r.pod(chunks);
+    r.pod(invalid);
+    r.pod(current_list);
+    r.vec(stream);
