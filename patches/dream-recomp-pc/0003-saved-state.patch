+// Saved state: the DSP and the 64 channels byte for byte, then the channel's host pointers are
+// rebuilt (they point into this mixer, its register image and the static tables, which differ
+// from run to run): mixer and register block from init's formula, the DSP send slot and the PLFO
+// table row as saved indices, the stream step functions from the registers as update_stream_step
+// leaves them.
+void Mixer::save(state::Writer& w) const {
+    w.begin("MIXR", 1);
+    w.pod(dsp_);
+    for (std::uint64_t v : {key_ons, key_offs, samples, nonzero_samples})
+        w.u64(v);
+    for (int i = 0; i < 64; ++i) {
+        const Channel& ch = chans_[i];
+        w.bytes(&ch, sizeof ch);
+        w.u32(ch.VolMix.DSPOut ? static_cast<std::uint32_t>(ch.VolMix.DSPOut - dsp_.MIXS)
+                               : 0xFFFFFFFFu);
+        w.u32(static_cast<std::uint32_t>(ch.lfo.plfo_scale - &kPlfoScales[0][0]));
+    }
+    w.end();
+}
+
+void Mixer::load(state::Reader& r) {
+    r.begin("MIXR", 1);
+    r.pod(dsp_);
+    for (std::uint64_t* v : {&key_ons, &key_offs, &samples, &nonzero_samples})
+        *v = r.u64();
+    for (int i = 0; i < 64; ++i) {
+        Channel& ch = chans_[i];
+        r.bytes(&ch, sizeof ch);
+        ch.mixer = this;
+        ch.ccd = reinterpret_cast<ChannelRegs*>(regs_ + static_cast<std::size_t>(i) * 0x80);
+        const std::uint32_t dsp = r.u32();
+        ch.VolMix.DSPOut = dsp == 0xFFFFFFFFu ? nullptr : &dsp_.MIXS[dsp];
+        ch.lfo.plfo_scale = &kPlfoScales[0][0] + r.u32();
+        ch.update_stream_step();
+    }
+    r.end();
+}
+
 }  // namespace dream::aica
